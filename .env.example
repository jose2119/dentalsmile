# Plantilla de variables de entorno para HappySmile
# Copia este archivo a .env y asigna los valores reales
DB_URL=jdbc:postgresql://<host>/<database>
DB_USERNAME=<usuario>
DB_PASSWORD=<contraseña>
JWT_SECRET=CambiarEstaClavePorUnaCadenaLargaYSeguraDeAlMenos32Caracteres
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080

